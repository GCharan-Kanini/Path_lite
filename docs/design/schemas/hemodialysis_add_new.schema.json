{
  "x-allowed-null-metadata": {
    "description": "Repository-level guidance for allowed-null audit and required metadata keys.",
    "reason_required_by_default": false,
    "audit_keys_required": ["allowed_null","allowed_null_reason_text","clarification_attempts_count","allowed_null_recorded_by","allowed_null_recorded_at"]
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/schemas/hemodialysis_add_new.schema.json",
  "title": "Hemodialysis - Add New Form Schema",
  "description": "Representative JSON Schema (draft-07) for the Hemodialysis Add New guided flow. Includes schema_version and field-level metadata for UI and audit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "form_id", "patient_id", "created_by", "created_at"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\d+\.\d+\.\d+$$",
      "description": "Semantic schema version in MAJOR.MINOR.PATCH format.",
      "examples": ["1.0.0"]
    },
    "form_id": { "type": "string", "format": "uuid" },
    "patient_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": ["string","null"], "x-allowed-null": true, "x-allowed-null-reason-required": false },
    "created_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "access_type": {
      "type": "string",
      "enum": ["catheter","fistula","graft","other"],
      "x-enum-canonical": { "catheter":"catheter","fistula":"arteriovenous_fistula","graft":"arteriovenous_graft","other":"other" }
    },
    "access_type_other_detail": { "type": ["string","null"], "x-allowed-null": true, "x-allowed-null-reason-required": false },
    "blood_flow_rate_ml_per_min": {
      "type": ["integer","null"],
      "minimum": 50,
      "maximum": 600,
      "x-allowed-null": true,
      "x-allowed-null-audit-keys": ["allowed_null","clarification_attempts_count","allowed_null_reason_text"],
      "x-allowed-null-reason-required": true
    },
    "dialysate_flow_rate_l_per_min": {
      "type": ["number","null"],
      "minimum": 0.5,
      "maximum": 2.0,
      "x-allowed-null": true,
      "x-allowed-null-audit-keys": ["allowed_null","clarification_attempts_count"],
      "x-allowed-null-reason-required": true
    },
    "dialyzer_type": { "type": "string", "enum": ["low_flux","high_flux","hemofilter","other"] },
    "anticoagulation": {
      "type": ["object","null"],
      "x-allowed-null": true,
      "x-allowed-null-reason-required": true,
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "enum": ["heparin","citrate","none","other"] },
        "dose_units": { "type": ["string","null"], "x-allowed-null": true, "x-allowed-null-reason-required": true },
        "dose_value": { "type": ["number","null"], "minimum": 0, "x-allowed-null": true, "x-allowed-null-reason-required": true }
      }
    },
    "notes": { "type": ["string","null"], "x-allowed-null": true, "x-allowed-null-audit-keys": ["allowed_null","allowed_null_reason_text"], "x-allowed-null-reason-required": false },
    "audit": {
      "type": "object",
      "required": ["last_modified_by","last_modified_at"],
      "properties": {
        "created_by_source": { "type": "string" },
        "last_modified_by": { "type": "string" },
        "last_modified_at": { "type": "string", "format": "date-time" },
        "change_reason": { "type": ["string","null"], "x-allowed-null": true }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "schema_version": "1.0.0",
      "form_id": "00000000-0000-4000-8000-000000000001",
      "patient_id": "patient-1234",
      "created_by": "nurse-5678",
      "created_at": "2026-09-01T08:30:00Z",
      "access_type": "fistula",
      "blood_flow_rate_ml_per_min": 350,
      "dialyzer_type": "high_flux",
      "anticoagulation": { "method": "heparin", "dose_value": 500.0, "dose_units": "units" },
      "audit": { "last_modified_by": "nurse-5678", "last_modified_at": "2026-09-01T08:31:00Z" }
    }
  ]
}
